# Postgres connection used by wamcp serve and the CLI.
DATABASE_URL=postgres://wamcp:wamcp@127.0.0.1:5432/wamcp
# Path to the 32-byte master key file (created by `wamcp init`). Must be mode 0600 and outside the data dir.
WAMCP_MASTER_KEY_FILE=~/.config/wamcp/master.key
# SMTP for the email operator channel (optional until configured in wamcp.yaml).
SMTP_URL=
# Log level: trace|debug|info|warn|error
LOG_LEVEL=info
